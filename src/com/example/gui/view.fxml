<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.gui.NotesController">

    <TextField fx:id="inputField" promptText="Введите заметку"/>
    <Button text="Добавить" onAction="#handleAdd"/>

    <ListView fx:id="listView"/>

    <HBox spacing="10">
        <Button text="Удалить" onAction="#handleRemove"/>
        <Button text="Количество" onAction="#handleCount"/>
    </HBox>

</VBox>
